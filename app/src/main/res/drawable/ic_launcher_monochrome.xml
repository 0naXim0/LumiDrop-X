<?xml version="1.0" encoding="utf-8"?>
<!--
    LumiDrop X launcher icon — themed-icon (API 33+ "monochrome") layer:
    the same LumiDrop mark as ic_launcher_foreground.xml reduced to pure
    white geometry (the system recolors it from its alpha channel) — the
    droplet drawn as a bold outline with the four-point light-spark solid
    at its heart, which keeps the mark legible as a single-color glyph.
    Referenced by both adaptive-icon XMLs in mipmap-anydpi-v26.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the drop, as an outline so the silhouette reads at glyph scale -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M54,28.5
            C54,37 61.8,42.5 65.9,48.4
            C68.4,51.5 70,53.7 70,56
            A16,16 0 1 1 38,56
            C38,53.7 39.6,51.5 42.1,48.4
            C46.2,42.5 54,37 54,28.5 Z" />

    <!-- the spark, solid -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,47 L56.2,53.8 L63,56 L56.2,58.2 L54,65 L51.8,58.2 L45,56 L51.8,53.8 Z" />
</vector>
