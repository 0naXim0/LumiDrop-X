<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Pass-20 (professional file-format glyph redesign) ══
     The generic no-thumbnail placeholder for unknown formats (FormatIcons'
     fallback in the Active/Received/History tabs) and the Docs icon in Web
     Client Settings → Layout & tabs order. The old glyph was a plain
     near-featureless rounded rectangle with a tiny mismatched fold mark —
     every "what even is this file" row looked identical and unfinished.
     The new one is the file family's real silhouette — the SAME
     corner-folded sheet geometry ic_file_apk / ic_file_zip already use
     (so a mixed list reads as one coherent icon set) — plus two quiet
     content lines that say "a document with something in it" at 16-20dp:
     a filled fold, rounded caps and joins, 1.7 stroke to match the family
     exactly. Tinted per-context (text_secondary as the neutral fallback;
     WebUiSettings uses accent_light/muted like every other row icon). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Document sheet with folded corner (family silhouette) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M14.8,2.6 L7,2.6 C6.3,2.6 5.8,3.1 5.8,3.8 L5.8,20.2 C5.8,20.9 6.3,21.4 7,21.4 L17,21.4 C17.7,21.4 18.2,20.9 18.2,20.2 L18.2,6 Z"/>
    <!-- The fold, filled like every family member -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.8,2.6 L14.8,5 C14.8,5.5 15.2,6 15.8,6 L18.2,6 Z"/>
    <!-- Quiet content lines: title + shorter body line -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8.9,11.2 L14.1,11.2"/>
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8.9,14.6 L12.2,14.6"/>
</vector>
