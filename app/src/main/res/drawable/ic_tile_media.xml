<?xml version="1.0" encoding="utf-8"?>
<!-- §tile-icons (post-v1.0): the Quick Share "Media" tile glyph — the
     classic photograph mark (rounded frame + sun + mountain range) with a
     bold center line split that reads as the photo/motion duality of a
     media library. Replaces the plain image-outline that could have been
     any rectangle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Frame -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M4.2,5.4 C3.5,5.4 3,5.9 3,6.6 L3,17.4 C3,18.1 3.5,18.6 4.2,18.6 L19.8,18.6 C20.5,18.6 21,18.1 21,17.4 L21,6.6 C21,5.9 20.5,5.4 19.8,5.4 L4.2,5.4 Z"/>
    <!-- Sun -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,9.9 a1.5,1.5 0 1,0 0.001,3 a1.5,1.5 0 0,0 -0.001,-3 Z"/>
    <!-- Mountain range -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M3.4,16.8 L8.1,11.6 L11.2,14.9 L14.6,11 L20.7,16.8"/>
</vector>
