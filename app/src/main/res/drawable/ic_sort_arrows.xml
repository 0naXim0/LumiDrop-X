<?xml version="1.0" encoding="utf-8"?>
<!-- GOAT-PASS 11 (§3): the sorting control's redesigned icon for the
     Received and History tab headers. The old glyph was a pair of opposing
     up/down arrows — functional, but visually dated. The redesign is the
     modern, widely-read "sort" mark: three horizontal bars of decreasing
     length, drawn in the app's own line-icon language (1.7 stroke, round
     caps) so it sits naturally beside the other stroke glyphs. Same 24dp
     viewport, same 15dp rendered footprint, same button position, clickable
     area and interaction — only the glyph is new, and it stays crisp and
     unmistakable at small sizes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M4.6,6.6 L19.4,6.6 M4.6,12 L14.2,12 M4.6,17.4 L9.4,17.4"/>
</vector>
