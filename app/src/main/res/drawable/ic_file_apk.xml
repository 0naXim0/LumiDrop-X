<?xml version="1.0" encoding="utf-8"?>
<!-- Pass-12 (Required Implementation 5): the dedicated APK file icon — used
     by every surface that renders an .apk with no real thumbnail available
     (Active tab sends, the receiving modal, queue rows) and, since Pass-20,
     the Apps row of Web Client Settings → Layout & tabs order (it replaced
     the loud filled ic_android robot there). A line-styled corner-folded
     document (the file family's shared silhouette — byte-identical sheet
     geometry to ic_file / ic_file_zip / the new Pass-20 ic_file) carrying
     the Android robot-head mark at its center — unmistakably "an Android
     package" at 16-20dp without the loud filled robot the old ic_android
     fallback used.
     ── Pass-20 polish: the robot mark is a touch larger and geometrically
     cleaner — a wider, lower dome that centers better inside the sheet,
     symmetric antennae, and slightly rounder eye dots — so it reads
     crisp at the 18dp the Layout rows render it. Stroke 1.7/1.5, round
     caps and joins, matching the family exactly. Tinted by FormatIcons
     with the app's green (the Android-family cue). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Document sheet with folded corner (family silhouette) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M14.8,2.6 L7,2.6 C6.3,2.6 5.8,3.1 5.8,3.8 L5.8,20.2 C5.8,20.9 6.3,21.4 7,21.4 L17,21.4 C17.7,21.4 18.2,20.9 18.2,20.2 L18.2,6 L14.8,2.6 Z"/>
    <!-- The fold -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M14.8,2.6 L14.8,5 C14.8,5.5 15.2,6 15.8,6 L18.2,6 Z"/>
    <!-- Android robot head mark, centered in the sheet -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8.6,13.7 C8.6,12.1 10.1,10.9 12,10.9 C13.9,10.9 15.4,12.1 15.4,13.7 L15.4,15.7 L8.6,15.7 Z"/>
    <!-- Antennae, symmetric -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M9.4,11.1 L8.5,9.8 M14.6,11.1 L15.5,9.8"/>
    <!-- Eyes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.5,12.8 h0.01 M13.5,12.8 h0.01"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"/>
</vector>
