<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md"/>
            <solid android:color="@color/bg_input_focused"/>
            <stroke android:width="1.4dp" android:color="@color/border_focus"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md"/>
            <solid android:color="@color/bg_input"/>
            <stroke android:width="@dimen/stroke_hairline" android:color="@color/border_subtle"/>
        </shape>
    </item>
</selector>
