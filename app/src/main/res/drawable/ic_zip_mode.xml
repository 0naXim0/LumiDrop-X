<?xml version="1.0" encoding="utf-8"?>
<!-- ══ GOAT-PASS 14 Phase 2 (§2): the ZIP SENDING MODE glyph ══════════════
     The app-side "send the queue as one ZIP" toggle's icon. Drawn in the
     exact stroke language of the Nearby Devices header's other quiet
     controls (ic_send / ic_download: 24dp grid, 1.65dp round caps/joins,
     stroke only) so the cluster reads as one family — an archive box with
     its zipper-pull slot, the instantly-read "ZIP / archive" mark in every
     file manager. Deliberately NOT the file-shaped ic_file_zip (that glyph
     is a FORMAT icon for archive files in listings); this one is a MODE
     control, and its box silhouette keeps the two roles visually distinct.
     Used by BOTH exposures of the one setting — the Nearby Devices header
     (btnZipModeToggle) and the Queue Files top row (btnZipModeToggleQueue)
     —  tinted by SendFragment.paintQuickToggles exactly like Quick Send /
     Quick Accept: accent while the mode is on, text_secondary while off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- The lid -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M3.5,5.5 H20.5 V9 H3.5 Z"/>
    <!-- The body -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M4.8,9 V18.6 C4.8,19.7 5.6,20.5 6.7,20.5 H17.3 C18.4,20.5 19.2,19.7 19.2,18.6 V9"/>
    <!-- The zipper-pull slot on the front face -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M10,13.2 H14"/>
</vector>
