<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Pass-18: the minimalist "blocked clients" glyph ══
     A no-entry sign — one circle, one diagonal — in the app's established
     outline-icon language (1.65 stroke, round caps/joins, same geometry
     family as ic_refresh). Stroke-drawn rather than the filled material
     "block" glyph so it sits visually beside the refresh icon at the same
     optical weight. Shown ONLY while one or more browser clients are
     blocked (SendFragment gates its visibility on the server's
     hasBlockedClients()); tapping opens the blocked-devices sheet. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M4,12 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 M17.66,6.34 L6.34,17.66"/>
</vector>
