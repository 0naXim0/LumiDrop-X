<?xml version="1.0" encoding="utf-8"?>
<!-- ══ Pass-26 (#2.5): the preview's select/deselect ring glyph ══════════
     The UNselected half of the preview's selection toggle: an empty
     stroked circle (the classic "not picked" mark of gallery-grade
     pickers). The SELECTED half is ic_check drawn in accent_light over an
     accent-tinted disc, applied in code (MediaPickerSheet paints both
     states onto one button). Drawn in the app's stroke language — 1.65dp
     round caps, 24dp grid, same optical inset as ic_check — so the two
     states read as one designed control. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M12,3.6 a8.4,8.4 0 1,0 0.01,0 Z"/>
</vector>
