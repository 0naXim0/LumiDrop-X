        android:fillColor="#FFFFFFFF"
        android:pathData="M12,9.3 C13.9,9.3 15.4,10.5 15.4,12 C15.4,13.5 13.9,14.7 12,14.7 C10.1,14.7 8.6,13.5 8.6,12 C8.6,10.5 10.1,9.3 12,9.3 Z"/>
