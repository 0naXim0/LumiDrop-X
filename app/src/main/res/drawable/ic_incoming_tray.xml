<?xml version="1.0" encoding="utf-8"?>
<!-- Pass-8 follow-up (redesigned minimized incoming-files badge): the
     badge's new PRIMARY glyph — a purpose-built "incoming tray" (an open
     tray with a file descending into it) replacing the generic bare
     ic_arrow_down the old badge used. One glance now says exactly what
     the badge is: files are coming IN and waiting. Drawn as strokes (not
     fills) at the same 2dp weight as the app's other line icons, so it
     reads cleanly at the badge's 20dp icon size on every density. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- File descending into the tray: shaft + chevron -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M12,3.4 V10.4"/>
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8.6,7 L12,10.4 L15.4,7"/>
    <!-- Open tray with a receiving lip (the inbox shape) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M3.6,12.8 H7.9 C8.4,14.7 10,15.8 12,15.8 C14,15.8 15.6,14.7 16.1,12.8 H20.4 V16.7 C20.4,18 19.4,19 18.1,19 H5.9 C4.6,19 3.6,18 3.6,16.7 Z"/>
</vector>
