<?xml version="1.0" encoding="utf-8"?>
<!-- GOAT v2: dedicated to the small (34dp) transfer-row thumbnails.
     Reusing bg_device_row's 16dp radius at this size would read as a
     circle rather than a rounded square — half of 34 is 17, so 16dp is
     nearly the whole way there. A proportionally smaller radius instead. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp"/>
    <solid android:color="@color/bg_secondary"/>
</shape>
