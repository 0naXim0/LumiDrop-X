<?xml version="1.0" encoding="utf-8"?>
<!-- Format icon: PDF. Post-v1.0 §static-format-icons: PDFs are the single
     most common no-thumbnail document type; they get their OWN glyph —
     a page with folded corner plus a bold solid label band across the
     middle (the universally-read "labeled document" shape), rendered in
     the dedicated pdf red by FormatIcons.tintFor, so a pdf row is
     identifiable at a glance before any text is read. The band is solid
     on purpose: at 16-20dp any lettering inside it would smear; the red
     tint + band + the row's own filename carry the identification. -->
