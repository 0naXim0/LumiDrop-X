<?xml version="1.0" encoding="utf-8"?>
<!-- GOAT-PASS 11 (§4): the Transfers icon, redesigned. The old glyph was a
     plain double-headed "swap" arrow pair — functional but visually dated.
     The redesign reads as what the tab IS: transfer BETWEEN DEVICES — a
     device dot on each side, an arrow leaving one and arriving at the other
     (upstream right, downstream left), drawn in the app's own line-icon
     language (1.65dp stroke, round caps/joins, 24dp grid, same optical
     inset as ic_settings) so the bottom navigation and the Transfers title
     row keep one designed family. Used in BOTH places the old glyph lived:
     the bottom navigation tab and the Transfers tab title. Sizes, positions
     and click behavior are untouched. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- upstream arrow: device dot -> chevron head -->
    <path
        android:strokeColor="#FFFFFF" android:strokeWidth="1.65"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8.6,8 H16 M13.3,5.4 L16.1,8 L13.3,10.6"/>
    <!-- downstream arrow: chevron head -> device dot -->
    <path
        android:strokeColor="#FFFFFF" android:strokeWidth="1.65"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M15.4,16 H8 M10.7,13.4 L7.9,16 L10.7,18.6"/>
    <!-- the two devices -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,8 m-1.7,0 a1.7,1.7 0 1,1 3.4,0 a1.7,1.7 0 1,1 -3.4,0"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M19,16 m-1.7,0 a1.7,1.7 0 1,1 3.4,0 a1.7,1.7 0 1,1 -3.4,0"/>
</vector>
