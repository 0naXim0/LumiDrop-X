<?xml version="1.0" encoding="utf-8"?>
<!-- Pass-8 follow-up (redesigned save/cancel dock): the quiet Discard
    control — deliberately the LIGHTEST-weight affordance on the dock
    (transparent fill, hairline border_subtle edge, muted label), so the
    eye lands on Save first and Discard stays a calm secondary option.
    Ripple-wrapped for feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/overlay_press">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md"/>
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md"/>
            <solid android:color="#00000000"/>
            <stroke android:width="@dimen/stroke_hairline" android:color="@color/border_subtle"/>
        </shape>
    </item>
</ripple>
