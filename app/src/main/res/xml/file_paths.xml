<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Covers the full external storage root (Downloads, DCIM, Documents,
         Music, the configured upload folder, and everywhere else this app
         already reads/serves files from via its own HTTP server). Sharing a
         local content:// Uri to a host-installed app for "Open With" is a
         strictly narrower exposure than what the app already does over the
         network via LumiDropServer, so this doesn't expand what the app can
         access — only how a single already-accessible file can be handed to
         another app on the same device. -->
    <external-path name="external" path="." />
    <!-- ── GOAT-PASS 7 Part 2 (§1): REMOVABLE STORAGE (SD card / USB OTG). ──────
         The external-path entry above maps ONLY the primary emulated volume
         (/storage/emulated/0); every removable volume mounts under its own
         /storage/XXXX-XXXX id, which that root can never address — a file
         browsed off an SD card through the Files sheet failed
         FileProvider.getUriForFile with "Failed to find configured root that
         contains /storage/XXXX-XXXX/..." and surfaced as the honest but wrong
         "This file can't be opened here" toast. This root covers the /storage
         mount tree (both the removable ids and, redundantly for safety, the
         emulated prefix — FileProvider always picks the MOST SPECIFIC matching
         root, so internal-storage files keep resolving through the narrower
         external-path entry above). The app already holds
         MANAGE_EXTERNAL_STORAGE (its whole file-server model is built on it)
         and already browses/reads/serves removable volumes as plain File
         paths; this entry only lets one ALREADY-accessible SD card file be
         handed to another app on the same device through a properly-addressed
         content:// Uri — no new access, no permission change, no SAF
         workaround. The provider stays exported=false with
         grantUriPermissions=true, so a Uri only works while this app
         explicitly grants FLAG_GRANT_READ_URI_PERMISSION per intent. -->
    <root-path name="storage" path="/storage/" />
    <!-- ── PRODUCTION FINAL PASS 23 (§2 — Critical Issue A): the UPDATER's ──
         staged APK root. The updater downloads release APKs to
         getCacheDir()/updates/ (app-private, no permissions, purgeable by
         the OS under storage pressure) and hands them to Android's package
         installer through this provider. Pass 22 shipped WITHOUT any root
         covering cacheDir — the transfer-sharing roots above only map
         external storage and /storage mounts — so FileProvider.getUriForFile
         threw "Failed to find configured root that contains
         /data/data/com.lumidrop.x/cache/updates/lumidrop-update-v1.0.4.apk"
         and every installation launch failed AFTER a perfectly good
         download (the exact real-device error). This entry maps ONLY the
         updates/ subdirectory (path="updates/", name is arbitrary but must
         stay stable — it appears in the generated content:// Uri), never
         the whole cache dir: the grant surface stays exactly one
         installer-readable APK per update, issued per-intent with
         FLAG_GRANT_READ_URI_PERMISSION by the holder of the file. -->
    <cache-path name="updates" path="updates/" />
    <!-- GOAT-PASS 13 (§10): the <files-path name="internal"> entry that used
         to sit here existed solely for the now-removed diagnostic log
         exports (AppLog/DiagLog/LogsActivity). Nothing else in the app
         shares a file from internal filesDir through the FileProvider. -->
</paths>
