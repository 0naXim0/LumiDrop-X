<?xml version="1.0" encoding="utf-8"?>
<!--
    LumiDrop X — application shell (Phase 17 §4: Consolidated Bottom
    Navigation Architecture).

    Previously: MainActivity WAS the Send screen, and Settings/Transfers
    were separate Activities reached via startActivity() — a full window
    transition (and, for Transfers, a poll-loop restart) on every tab
    switch. Now: MainActivity hosts this shell, swapping SendFragment /
    TransfersFragment / SettingsFragment in and out of fragmentContainer
    via FragmentManager show()/hide() (state — scroll position, expanded
    cards — is preserved across switches; nothing is destroyed and
    recreated), with a single persistent BottomNavBar driving the switch.

    blackoutOverlay and floatingTransferBar used to live in the Send
    screen's own layout. They're promoted here because both are meant to
    cover the WHOLE app, not just one tab — blackout should black out the
    bottom nav too, and the floating transfer popup is documented (see its
    own comment below) to show over any tab except Transfers itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- Phase 18 fix: this used to carry layout_marginBottom="@dimen/
         nav_bar_clearance", which left a gap where rootFrame's own flat
         background showed through as a distinct rectangular strip behind
         the floating nav bar - breaking the "floating over content"
         look the margin was meant to help with in the first place. Fills
         the whole screen now; each fragment's own root view (which already
         paints its own bg_deep background, same color as rootFrame's, so
         there's no seam either way) reserves the nav-bar clearance itself
         via bottom PADDING on its scrollable/content area instead of a
         container-level margin - padding still leaves content clear of
         the bar, but doesn't stop the background from reaching the true
         screen edge underneath it. -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top" />

    <!-- Phase 18: the nav bar is now a floating pill (see bg_nav_bar.xml)
         with visible background showing around and below it, so the old
         "content fades into the nav bar's flush top edge" trick
         (contentFadeToNav) no longer applies; content simply stops with
         plain clearance above the floating bar instead. Side margins here
         (not present pre-Phase-18) are what make it float rather than dock
         edge-to-edge. The 12dp bottom margin is a deliberate small gap from
         the screen edge (requested explicitly, especially for gesture-nav
         devices where a flush bar can look like it's merging into the
         gesture inset), so that app isn't edge-to-edge, meaning that 12dp
         sits on top of whatever the system nav bar/gesture inset already
         reserves outside rootFrame, rather than needing to account for it
         here. -->
    <!-- ══ Pass-16/19/20: the professional gradient, UNDERNEATH the tab bar ══
         The gradient effect pass-15 baked INSIDE the bar's own background is
         removed from there entirely (bg_nav_bar.xml is flat again) and lives
         HERE: a band anchored to the screen's bottom edge behind the bar.
         Pass-20 grew the band from 72dp (exactly the old bar's footprint) to
         88dp — the new 52dp bar + its 12dp bottom margin = 64dp, plus ~24dp
         of visible, gently-darkening fade ABOVE the bar (the "increase the
         height/range of the gradient effect by a small amount" request),
         so scrolling content slides under the bar and dissolves into the
         app's own deep background on BOTH sides of the bar's edge instead
         of only in the 12dp gap. The opaque bar itself covers the band's
         64dp lower portion; the fade is also DARKER end-to-end than the
         pass-19 curve (every stop is bg_deep itself, see
         bg_nav_under_gradient.xml + applyNavUnderGradient). Declared
         BEFORE bottomNav so the bar's own clean flat surface is never
         tinted; fragment content (declared first) stays under both.
         blackoutOverlay (higher elevation, declared later) still covers
         it. -->
    <View
        android:id="@+id/navUnderGradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_gradient_band_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_under_gradient" />

    <com.lumidrop.x.ui.BottomNavBar
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:layout_gravity="bottom" />



    <!-- ══════ AMOLED BLACKOUT OVERLAY ══════
         Covers everything, including the bottom nav. Long-press to exit.
         Pure black = zero AMOLED pixel power. -->
    <View
        android:id="@+id/blackoutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="@dimen/elevation_blackout"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true"
        android:contentDescription="Blackout mode active. Long press to exit." />

    <!-- ══════ FLOATING TRANSFER POPUP (optional — enabled in Settings) ══════
         Minimalist collapsed bar pinned bottom-center, sitting just above
         the nav bar. Tapping expands an inline detail panel. Hidden while
         the Transfers tab itself is selected (that screen already shows
         full detail) — shown over Send/Settings otherwise. Shown only when
         isFloatingTransferPopup() is true AND there are active transfers
         AND the app is in the foreground.

         Phase 18 V8: rebuilt as two rounded bg_float_bar surfaces (each
         carrying its own elevation) instead of one flat rectangle in the
         old overlay_bar_collapsed/expanded colors — the one remaining
         surface in the app without the rounded-card treatment everything
         else got, per colors.xml's own "not yet rebuilt" note. Side
         margins match the nav bar's so both floating elements read as the
         same visual language. Outer wrapper carries no elevation of its
         own now — it's a plain layout container, not a surface; each
         child casts its own shadow instead. -->
    <LinearLayout
        android:id="@+id/floatingTransferBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/nav_bar_clearance"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Collapsed bar -->
        <LinearLayout
            android:id="@+id/floatBarCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_float_bar"
            android:elevation="@dimen/elevation_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_swap"
                android:layout_marginEnd="8dp"
                app:tint="@color/accent_light" />

            <TextView
                android:id="@+id/tvFloatBarCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/tvFloatBarChevron"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_up" />

        </LinearLayout>

        <!-- Expanded inline list (max 4 items, scrollable). Small top gap
             separates it from the collapsed bar above as its own distinct
             rounded surface rather than a seamless continuation. -->
        <ScrollView
            android:id="@+id/floatBarExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxHeight="240dp"
            android:background="@drawable/bg_float_bar"
            android:elevation="@dimen/elevation_card"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/floatBarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
